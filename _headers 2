# Same rules as netlify.toml, but shipped INSIDE dist so a drag-and-drop deploy
# keeps them. Without this, dragging the folder loses the service-worker header
# and an old worker can keep serving a stale build after you have deployed a new
# one — the single most confusing way for a deploy to look like it did nothing.

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints these, so they are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Art filenames are stable and the service worker caches them first anyway.
/art/*
  Cache-Control: public, max-age=86400
